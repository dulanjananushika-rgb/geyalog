{
  "expo": {
    "name": "GeyaLog",
    "slug": "geyalog",
    "scheme": "geyalog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "lk.geyalog.app"
    }
  }
}
